rules_version = '2';

// MindNest — Firestore security rules.
// On the Spark plan there is no server: these rules ARE the backend's
// enforcement layer. Layout is documented in lib/core/firebase/collections.dart.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isUser(id) { return signedIn() && uid() == id; }
    function data() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }
    function hasBlocked(owner, other) {
      return exists(/databases/$(database)/documents/users/$(owner)/blocked/$(other));
    }
    function isVerifiedPro(id) {
      return get(/databases/$(database)/documents/therapists/$(id)).data.verified == true;
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId)
        && data().role in ['client', 'professional']
        && data().verification == 'none'
        && data().onboarded == false;
      // Role is fixed; verification can only advance to `pending` — approval
      // is an admin action (scripts/approve_pro.mjs, Admin SDK bypasses rules).
      allow update: if isUser(userId)
        && onlyChanges(['name', 'onboarded', 'verification', 'title', 'phone', 'bio', 'notificationPrefs'])
        && (data().verification == resource.data.verification || data().verification == 'pending');
      // Account deletion (the app erases subcollections first).
      allow delete: if isUser(userId);

      match /private/{docId} {
        allow read, write: if isUser(userId);
      }
      match /{col}/{docId} {
        allow read, write: if isUser(userId)
          && col in ['moods', 'journal', 'likedPosts', 'savedPosts', 'savedTherapists', 'fcmTokens', 'blocked'];
      }

      // Verification documents, stored as ≤900 KB byte chunks (no Storage
      // on Spark). Owner-only; reviewers read them with the Admin SDK.
      match /verificationFiles/{kind} {
        allow read, delete: if isUser(userId);
        allow create, update: if isUser(userId)
          && kind in ['licence', 'photoId', 'qualifications']
          && data().keys().hasOnly(['name', 'mime', 'size', 'chunks', 'uploadedAt'])
          && data().name is string && data().name.size() <= 200
          && data().mime in ['application/pdf', 'image/jpeg']
          && data().size is int && data().size <= 5 * 1024 * 1024
          && data().chunks is int && data().chunks <= 6;
        match /chunks/{i} {
          allow read, delete: if isUser(userId);
          allow create, update: if isUser(userId)
            && data().keys().hasOnly(['data'])
            && data().data is bytes && data().data.size() <= 900 * 1024;
        }
      }

      // Inbox: written by whoever triggers the event, read by the owner.
      match /notifications/{nid} {
        function validShape() {
          return data().keys().hasOnly(['type', 'title', 'body', 'targetId', 'senderId', 'unread', 'createdAt'])
            && data().type in ['booking', 'message', 'mood', 'content']
            && data().title is string && data().title.size() <= 120
            && data().body is string && data().body.size() <= 400
            && data().senderId == uid()
            && data().unread == true;
        }
        allow read, delete: if isUser(userId);
        allow create: if signedIn() && validShape();
        allow update: if (isUser(userId) && onlyChanges(['unread']))
          // Rolling items (e.g. one per conversation) are re-set by the sender.
          || (signedIn() && resource.data.senderId == uid() && validShape());
      }
    }

    // ── Profile photos ─────────────────────────────────────────────────
    // Small JPEGs (no Storage on Spark). Public to signed-in users.
    match /avatars/{userId} {
      allow read: if signedIn();
      allow delete: if isUser(userId);
      allow create, update: if isUser(userId)
        && data().keys().hasOnly(['data', 'updatedAt'])
        && data().data is bytes && data().data.size() <= 150 * 1024;
    }

    // ── Therapist directory ────────────────────────────────────────────
    match /therapists/{proId} {
      allow read: if signedIn();
      allow create: if isUser(proId)
        && data().verified == false && data().rating == 0 && data().reviews == 0;
      // `verified`, `rating` and `reviews` are admin/server-managed.
      allow update: if (isUser(proId)
          && !changed().hasAny(['verified', 'rating', 'reviews', 'lastReviewId']))
        // A client's new review bumps the aggregate in the same write.
        || (signedIn()
          && onlyChanges(['rating', 'reviews', 'lastReviewId'])
          && data().reviews == resource.data.get('reviews', 0) + 1
          && !exists(/databases/$(database)/documents/therapists/$(proId)/reviews/$(data().lastReviewId))
          && getAfter(/databases/$(database)/documents/therapists/$(proId)/reviews/$(data().lastReviewId)).data.authorId == uid()
          && math.abs(data().rating
               - (resource.data.get('rating', 0) * resource.data.get('reviews', 0)
                  + getAfter(/databases/$(database)/documents/therapists/$(proId)/reviews/$(data().lastReviewId)).data.rating)
                 / (resource.data.get('reviews', 0) + 1)) < 0.01);
      allow delete: if isUser(proId);

      // One review per completed session; the id is the appointment id.
      match /reviews/{rid} {
        function appt() { return get(/databases/$(database)/documents/appointments/$(rid)).data; }
        allow read: if signedIn();
        allow create: if signedIn()
          && data().keys().hasOnly(['authorId', 'name', 'rating', 'text', 'createdAt'])
          && data().authorId == uid()
          && appt().clientId == uid()
          && appt().therapistId == proId
          && appt().status == 'completed'
          && data().rating is int && data().rating >= 1 && data().rating <= 5
          && data().name is string && data().name.size() <= 40
          && data().text is string && data().text.size() <= 1000;
      }

      // Slot locks: one per booked start time; prevents double booking.
      match /busy/{slot} {
        allow read: if signedIn();
        allow create: if signedIn()
          && data().clientId == uid()
          && getAfter(/databases/$(database)/documents/appointments/$(data().appointmentId)).data.clientId == uid()
          && getAfter(/databases/$(database)/documents/appointments/$(data().appointmentId)).data.therapistId == proId;
        allow delete: if isUser(proId) || (signedIn() && resource.data.clientId == uid());
      }

      // Practitioner-private client records, notes and goals.
      match /clients/{clientId} {
        allow read, write: if isUser(proId);
        match /{sub}/{id} {
          allow read, write: if isUser(proId) && sub in ['notes', 'goals'];
        }
      }
    }

    // ── Appointments ───────────────────────────────────────────────────
    match /appointments/{aid} {
      function sessionEnd() {
        return resource.data.startsAt + duration.value(resource.data.get('minutes', 50), 'm');
      }
      allow read: if signedIn()
        && (resource.data.clientId == uid() || resource.data.therapistId == uid());
      allow create: if signedIn()
        && data().clientId == uid()
        && data().therapistId != uid()
        && data().status == 'pending'
        && data().startsAt is timestamp && data().startsAt > request.time
        && isVerifiedPro(data().therapistId)
        && !hasBlocked(data().therapistId, uid())
        && !hasBlocked(uid(), data().therapistId);
      allow update: if signedIn() && (
        // Client cancels.
        (resource.data.clientId == uid()
          && onlyChanges(['status', 'cancelledAt'])
          && data().status == 'cancelled')
        // Professional cancels an upcoming session (e.g. deleting their account).
        || (resource.data.therapistId == uid()
          && resource.data.status in ['pending', 'accepted']
          && resource.data.startsAt > request.time
          && onlyChanges(['status', 'cancelledAt'])
          && data().status == 'cancelled')
        // Professional responds to a pending request.
        || (resource.data.therapistId == uid()
          && resource.data.status == 'pending'
          && onlyChanges(['status', 'respondedAt'])
          && data().status in ['accepted', 'declined'])
        // Professional records whether the client paid them directly.
        || (resource.data.therapistId == uid()
          && resource.data.status == 'completed'
          && onlyChanges(['paid', 'paidAt'])
          && data().paid is bool)
        // Professional marks an ended session as held or missed.
        || (resource.data.therapistId == uid()
          && resource.data.status == 'accepted'
          && request.time > sessionEnd()
          && onlyChanges(['status', 'completedBy', 'completedAt'])
          && data().status in ['completed', 'noShow']
          && data().completedBy == 'therapist')
        // Either side auto-completes a session left unmarked for 24h.
        || ((resource.data.therapistId == uid() || resource.data.clientId == uid())
          && resource.data.status == 'accepted'
          && request.time > sessionEnd() + duration.value(24, 'h')
          && onlyChanges(['status', 'completedBy', 'completedAt'])
          && data().status == 'completed'
          && data().completedBy == 'auto')
        // Client flags the session reviewed, alongside creating the review.
        || (resource.data.clientId == uid()
          && resource.data.status == 'completed'
          && resource.data.get('reviewed', false) == false
          && onlyChanges(['reviewed'])
          && data().reviewed == true
          && existsAfter(/databases/$(database)/documents/therapists/$(resource.data.therapistId)/reviews/$(aid)))
      );
      allow delete: if false;
    }

    // ── Chat ───────────────────────────────────────────────────────────
    match /conversations/{cid} {
      function member() { return uid() in resource.data.participants; }
      // `resource == null` lets a participant check whether a thread exists.
      allow read: if signedIn() && (resource == null || member());
      allow create: if signedIn()
        && uid() in data().participants
        && data().participants.size() == 2
        && cid == data().participants[0] + '_' + data().participants[1]
        && data().clientId == data().participants[0]
        && data().proId == data().participants[1];
      allow update: if signedIn() && member()
        && !changed().hasAny(['participants', 'clientId', 'proId']);

      match /messages/{mid} {
        function conv() { return get(/databases/$(database)/documents/conversations/$(cid)).data; }
        function convMember() { return uid() in conv().participants; }
        function recipient() {
          return conv().participants[0] == uid() ? conv().participants[1] : conv().participants[0];
        }
        allow read: if signedIn() && convMember();
        allow create: if signedIn() && convMember()
          && !hasBlocked(recipient(), uid())
          && data().senderId == uid()
          && data().text is string && data().text.size() <= 4000
          && (data().text.size() > 0 || (
            data().attachment is map
            && data().attachment.kind in ['image', 'pdf']
            && exists(/databases/$(database)/documents/conversations/$(cid)/attachments/$(data().attachment.id))));
      }

      // Photos and PDFs sent in the thread (≤900 KB, no Storage on Spark).
      match /attachments/{attId} {
        function member() {
          return uid() in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
        }
        allow read: if signedIn() && member();
        allow create: if signedIn() && member()
          && data().keys().hasOnly(['senderId', 'kind', 'name', 'data'])
          && data().senderId == uid()
          && data().kind in ['image', 'pdf']
          && data().name is string && data().name.size() <= 200
          && data().data is bytes && data().data.size() <= 900 * 1024;
      }
    }

    // Lets a user find their own comments across posts (account deletion).
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn() && resource.data.authorId == uid();
    }

    // ── Reports ────────────────────────────────────────────────────────
    // Write-only for users; moderators read them with the Admin SDK.
    match /reports/{rid} {
      allow create: if signedIn()
        && data().keys().hasOnly(['reporterId', 'targetType', 'targetPath', 'targetOwnerId', 'targetOwnerName',
                                  'reason', 'details', 'status', 'createdAt'])
        && data().reporterId == uid()
        && data().targetType in ['post', 'comment', 'message', 'user']
        && data().targetPath is string && data().targetPath.size() <= 300
        && data().targetOwnerId is string && data().targetOwnerId != uid()
        && data().reason in ['harassment', 'hate', 'selfHarm', 'spam', 'inappropriate', 'impersonation', 'other']
        && data().details is string && data().details.size() <= 1000
        && data().status == 'open';
    }

    // ── Feed ───────────────────────────────────────────────────────────
    match /posts/{pid} {
      function likedPath() {
        return /databases/$(database)/documents/users/$(uid())/likedPosts/$(pid);
      }
      function likeToggle() {
        return onlyChanges(['likes']) && (
          (data().likes == resource.data.likes + 1 && !exists(likedPath()) && existsAfter(likedPath()))
          || (data().likes == resource.data.likes - 1 && exists(likedPath()) && !existsAfter(likedPath()))
        );
      }
      allow read: if signedIn()
        && (resource.data.status == 'published' || resource.data.authorId == uid());
      allow create: if signedIn()
        && data().authorId == uid()
        && isVerifiedPro(uid())
        && data().likes == 0 && data().comments == 0 && data().views == 0
        && data().status in ['published', 'draft'];
      allow update: if signedIn() && (
        (resource.data.authorId == uid()
          && !changed().hasAny(['authorId', 'likes', 'comments', 'views']))
        || (resource.data.status == 'published' && (
          likeToggle()
          || (onlyChanges(['comments']) && data().comments == resource.data.comments + 1)
          || (onlyChanges(['views']) && data().views == resource.data.views + 1)
        ))
      );
      allow delete: if signedIn() && resource.data.authorId == uid();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && data().authorId == uid()
          && data().likedBy.size() == 0
          && data().text is string && data().text.size() > 0 && data().text.size() <= 2000
          && get(/databases/$(database)/documents/posts/$(pid)).data.status == 'published';
        // Anyone may add/remove only their own like.
        allow update: if signedIn() && onlyChanges(['likedBy'])
          && data().likedBy.toSet().difference(resource.data.likedBy.toSet())
               .union(resource.data.likedBy.toSet().difference(data().likedBy.toSet()))
               == [uid()].toSet();
        allow delete: if signedIn() && resource.data.authorId == uid();
      }
    }
  }
}
